        <mxCell id="Mrkxx1X9o3tyWwIIMo9J-35" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-family: NeverMind, sans-serif, &amp;quot;Microsoft YaHei&amp;quot;, &amp;quot;PingFang SC&amp;quot;, &amp;quot;Microsoft JhengHei&amp;quot;, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 14px; white-space-collapse: break-spaces; background-color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;&lt;b&gt; Capa de Gobernanza&lt;/b&gt;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;: Asegura que no se vean los datos sensibles &lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=none;strokeColor=#6c8ebf;" parent="1" vertex="1">
