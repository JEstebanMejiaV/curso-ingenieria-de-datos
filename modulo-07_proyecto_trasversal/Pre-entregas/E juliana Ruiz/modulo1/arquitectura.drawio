        <mxCell id="F4A8c3nW180QPXoV6hYj-17" value="&lt;div&gt;&lt;span data-index-in-node=&quot;32&quot; data-path-to-node=&quot;2&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot; data-index-in-node=&quot;23&quot; data-path-to-node=&quot;1&quot;&gt;Data Lake /&amp;nbsp;&lt;/b&gt;&lt;b&gt;&lt;font style=&quot;font-size: 14px; color: light-dark(rgb(255, 0, 0), rgb(255, 255, 255));&quot; face=&quot;Tahoma&quot;&gt;Arquitectura de Medallón&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span data-index-in-node=&quot;32&quot; data-path-to-node=&quot;2&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot; face=&quot;Tahoma&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span data-index-in-node=&quot;32&quot; data-path-to-node=&quot;2&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot; face=&quot;Tahoma&quot;&gt;&lt;span style=&quot;&quot; class=&quot;citation-9&quot;&gt;&amp;nbsp;Patrón de diseño que organiza los datos en tres capas lógicas (&lt;/span&gt;&lt;b style=&quot;&quot; data-index-in-node=&quot;124&quot; data-path-to-node=&quot;1&quot;&gt;&lt;span class=&quot;citation-9&quot;&gt;Bronce, Plata y Oro&lt;/span&gt;&lt;/b&gt;&lt;span style=&quot;&quot; class=&quot;citation-9 citation-end-9&quot;&gt;).&lt;sup data-turn-source-index=&quot;1&quot; class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt; &lt;span style=&quot;&quot; class=&quot;citation-8 citation-end-8&quot;&gt;El objetivo es que, a medida que el dato avanza por estas capas, su calidad y estructura mejoran&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=middle;" parent="1" vertex="1">
