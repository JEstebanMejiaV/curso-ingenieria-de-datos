        <mxCell id="F4A8c3nW180QPXoV6hYj-29" value="&lt;font style=&quot;&quot;&gt;&lt;b style=&quot;color: rgb(255, 0, 0); text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;PySpark&amp;nbsp;&lt;/font&gt;&lt;/b&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Es el motor que toma los datos de la zona &lt;/span&gt;&lt;b style=&quot;font-size: 14px;&quot; data-index-in-node=&quot;42&quot; data-path-to-node=&quot;5&quot;&gt;Raw&lt;/b&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;, les aplica reglas de negocio y los deja listos en la zona &lt;/span&gt;&lt;b style=&quot;font-size: 14px;&quot; data-index-in-node=&quot;109&quot; data-path-to-node=&quot;5&quot;&gt;Silver&lt;/b&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt; o &lt;/span&gt;&lt;b style=&quot;font-size: 14px;&quot; data-index-in-node=&quot;118&quot; data-path-to-node=&quot;5&quot;&gt;Gold&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;" parent="1" vertex="1">
