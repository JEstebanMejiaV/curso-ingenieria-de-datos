        <mxCell id="Mrkxx1X9o3tyWwIIMo9J-27" value="&lt;font face=&quot;Helvetica&quot;&gt;Formato del dato:&lt;/font&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;&quot; data-index-in-node=&quot;18&quot; data-path-to-node=&quot;9,1,0&quot;&gt;Apache Parquet&lt;/span&gt;.&amp;nbsp;(organizado por carpetas de negocio, por ejemplo: &lt;code style=&quot;&quot; data-index-in-node=&quot;76&quot; data-path-to-node=&quot;13,1,0&quot;&gt;/ventas_mensuales/&lt;/code&gt; o &lt;code style=&quot;&quot; data-index-in-node=&quot;97&quot; data-path-to-node=&quot;13,1,0&quot;&gt;/alertas_frio/&lt;/code&gt;).&lt;/font&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
