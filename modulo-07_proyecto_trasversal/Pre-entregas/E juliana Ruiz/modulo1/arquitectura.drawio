        <mxCell id="Mrkxx1X9o3tyWwIIMo9J-42" value="&lt;div style=&quot;&quot;&gt;&lt;font color=&quot;#ff0000&quot;&gt;&lt;b&gt;PySpark&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;h4 data-path-to-node=&quot;8&quot;&gt;1. &lt;span style=&quot;font-weight: normal;&quot;&gt;Limpieza (Data Cleaning)&lt;/span&gt;&lt;/h4&gt;&lt;h4 data-path-to-node=&quot;8&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, sans-serif; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-weight: normal;&quot;&gt;2. Transformación (Data Transformation)&lt;/span&gt;&lt;/h4&gt;&lt;div style=&quot;&quot;&gt;3. Cálculo de KPIs (Los Indicadores)&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;/blockquote&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;i style=&quot;font-weight: bold;&quot;&gt;&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp; &lt;/i&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;&lt;i style=&quot;font-weight: bold;&quot;&gt;&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;align=left;" parent="1" vertex="1">
          <mxGeometry x="1340" y="1611" width="270" height="132" as="geometry" />
        </mxCell>
        <mxCell id="Mrkxx1X9o3tyWwIIMo9J-43" value="&lt;div style=&quot;&quot;&gt;&lt;font color=&quot;#ff0000&quot;&gt;&lt;b&gt;PySpark&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;h4 data-path-to-node=&quot;8&quot;&gt;1. Limpieza (Data Cleaning)&lt;/h4&gt;&lt;ul data-path-to-node=&quot;9&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;9,0,0&quot;&gt;&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;9,0,0&quot;&gt;El reto:&lt;/b&gt; En los archivos de LogiData, a veces el &lt;code data-index-in-node=&quot;49&quot; data-path-to-node=&quot;9,0,0&quot;&gt;id_cliente&lt;/code&gt; viene vacío o el nombre está en minúsculas y otras en mayúsculas.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;9,1,0&quot;&gt;&lt;b data-index-in-node=&quot;0&quot; data-path-to-node=&quot;9,1,0&quot;&gt;La acción:&lt;/b&gt; El Job de PySpark detecta los nulos y los elimina o les pone un valor por defecto. Estandariza los textos (ej: todo a MAYÚSCULAS) para que al buscar &quot;Retail&quot; no sea distinto de &quot;retail&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;/blockquote&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;i style=&quot;font-weight: bold;&quot;&gt;&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp; &lt;/i&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;&lt;i style=&quot;font-weight: bold;&quot;&gt;&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;align=left;" parent="1" vertex="1">
          <mxGeometry x="1750" y="1460" width="1038" height="140" as="geometry" />
        </mxCell>
        <mxCell id="Mrkxx1X9o3tyWwIIMo9J-44" value="&lt;div style=&quot;&quot;&gt;&lt;font color=&quot;#ff0000&quot;&gt;&lt;b&gt;PySpark&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: &amp;quot;Google Sans&amp;quot;, sans-serif;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-family: &amp;quot;Google Sans&amp;quot;, sans-serif;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;2. Transformación (Data Transformation)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 1.15 !important; margin-top: 0px !important;&quot; data-index-in-node=&quot;0&quot; data-path-to-node=&quot;11,0,0&quot;&gt;&lt;font face=&quot;Google Sans, sans-serif&quot;&gt;&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;ul style=&quot;padding-inline-start: 32px; line-height: 1.15 !important; margin-top: 0px !important;&quot; data-path-to-node=&quot;11&quot;&gt;&lt;li style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;p style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot; data-path-to-node=&quot;11,0,0&quot;&gt;&lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot; data-index-in-node=&quot;0&quot; data-path-to-node=&quot;11,0,0&quot;&gt;&lt;font face=&quot;Google Sans Text, sans-serif&quot;&gt;El reto:&lt;/font&gt;&lt;/b&gt;&lt;font face=&quot;Google Sans Text, sans-serif&quot;&gt; Tienes la fecha y hora por separado, o en formatos que no sirven para cálculos.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;p style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot; data-path-to-node=&quot;11,1,0&quot;&gt;&lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot; data-index-in-node=&quot;0&quot; data-path-to-node=&quot;11,1,0&quot;&gt;La acción:&lt;/b&gt; PySpark convierte esos Strings en objetos de fecha reales. Calcula, por ejemplo, el &lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot; data-index-in-node=&quot;95&quot; data-path-to-node=&quot;11,1,0&quot;&gt;Tiempo de Entrega&lt;/b&gt;:&lt;/p&gt;&lt;div style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot; data-path-to-node=&quot;11,1,1&quot;&gt;&lt;div style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot; data-math=&quot;Tiempo\_Entrega = Hora\_Real - Hora\_Programada&quot; class=&quot;math-block&quot;&gt;$$Tiempo\_Entrega = Hora\_Real - Hora\_Programada$$&lt;/div&gt;&lt;/div&gt;&lt;p style=&quot;line-height: 1.15 !important; margin-top: 0px !important;&quot; data-path-to-node=&quot;11,1,2&quot;&gt;Si el resultado es positivo, marca ese pedido con una etiqueta de &quot;RETRASADO&quot;.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;h4 data-path-to-node=&quot;8&quot;&gt;&lt;span style=&quot;color: rgba(0, 0, 0, 0); font-family: monospace; font-size: 0px; font-weight: 400; text-wrap-mode: nowrap;&quot;&gt;%3CmxGraphModel%3E%3Croot%3E%3CmxCell%20id%3D%220%22%2F%3E%3CmxCell%20id%3D%221%22%20parent%3D%220%22%2F%3E%3CmxCell%20id%3D%222%22%20value%3D%22%26lt%3Bdiv%20style%3D%26quot%3B%26quot%3B%26gt%3B%26lt%3Bfont%20color%3D%26quot%3B%23ff0000%26quot%3B%26gt%3B%26lt%3Bb%26gt%3BPySpark%26lt%3B%2Fb%26gt%3B%26lt%3B%2Ffont%26gt%3B%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%20style%3D%26quot%3B%26quot%3B%26gt%3B%26lt%3Bspan%20style%3D%26quot%3Bbackground-color%3A%20transparent%3B%20color%3A%20light-dark(rgb(0%2C%200%2C%200)%2C%20rgb(255%2C%20255%2C%20255))%3B%26quot%3B%26gt%3B%26lt%3Bspan%20style%3D%26quot%3Bwhite-space%3A%20pre%3B%26quot%3B%26gt%3B%26%239%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3B%2Fspan%26gt%3B%26lt%3B%2Fdiv%26gt%3B%26lt%3Bblockquote%20style%3D%26quot%3Bmargin%3A%200%200%200%2040px%3B%20border%3A%20none%3B%20padding%3A%200px%3B%26quot%3B%26gt%3B%26lt%3Bh4%20data-path-to-node%3D%26quot%3B8%26quot%3B%26gt%3B1.%20Limpieza%20(Data%20Cleaning)%26lt%3B%2Fh4%26gt%3B%26lt%3Bul%20data-path-to-node%3D%26quot%3B9%26quot%3B%26gt%3B%26lt%3Bli%26gt%3B%26lt%3Bp%20data-path-to-node%3D%26quot%3B9%2C0%2C0%26quot%3B%26gt%3B%26lt%3Bb%20data-index-in-node%3D%26quot%3B0%26quot%3B%20data-path-to-node%3D%26quot%3B9%2C0%2C0%26quot%3B%26gt%3BEl%20reto%3A%26lt%3B%2Fb%26gt%3B%20En%20los%20archivos%20de%20LogiData%2C%20a%20veces%20el%20%26lt%3Bcode%20data-index-in-node%3D%26quot%3B49%26quot%3B%20data-path-to-node%3D%26quot%3B9%2C0%2C0%26quot%3B%26gt%3Bid_cliente%26lt%3B%2Fcode%26gt%3B%20viene%20vac%C3%ADo%20o%20el%20nombre%20est%C3%A1%20en%20min%C3%BAsculas%20y%20otras%20en%20may%C3%BAsculas.%26lt%3B%2Fp%26gt%3B%26lt%3B%2Fli%26gt%3B%26lt%3Bli%26gt%3B%26lt%3Bp%20data-path-to-node%3D%26quot%3B9%2C1%2C0%26quot%3B%26gt%3B%26lt%3Bb%20data-index-in-node%3D%26quot%3B0%26quot%3B%20data-path-to-node%3D%26quot%3B9%2C1%2C0%26quot%3B%26gt%3BLa%20acci%C3%B3n%3A%26lt%3B%2Fb%26gt%3B%20El%20Job%20de%20PySpark%20detecta%20los%20nulos%20y%20los%20elimina%20o%20les%20pone%20un%20valor%20por%20defecto.%20Estandariza%20los%20textos%20(ej%3A%20todo%20a%20MAY%C3%9ASCULAS)%20para%20que%20al%20buscar%20%26quot%3BRetail%26quot%3B%20no%20sea%20distinto%20de%20%26quot%3Bretail%26lt%3B%2Fp%26gt%3B%26lt%3B%2Fli%26gt%3B%26lt%3B%2Ful%26gt%3B%26lt%3Bdiv%20style%3D%26quot%3B%26quot%3B%26gt%3B%26amp%3Bnbsp%3B%26amp%3Bnbsp%3B%26lt%3B%2Fdiv%26gt%3B%26lt%3B%2Fblockquote%26gt%3B%26lt%3Bdiv%20style%3D%26quot%3B%26quot%3B%26gt%3B%26lt%3Bspan%20style%3D%26quot%3Bbackground-color%3A%20transparent%3B%20color%3A%20light-dark(rgb(0%2C%200%2C%200)%2C%20rgb(255%2C%20255%2C%20255))%3B%26quot%3B%26gt%3B%26lt%3Bb%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3B%2Fb%26gt%3B%26lt%3B%2Fspan%26gt%3B%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%20style%3D%26quot%3B%26quot%3B%26gt%3B%26lt%3Bi%20style%3D%26quot%3Bfont-weight%3A%20bold%3B%26quot%3B%26gt%3B%26amp%3Bnbsp%3B%26lt%3Bspan%20style%3D%26quot%3Bwhite-space%3A%20pre%3B%26quot%3B%26gt%3B%26%239%3B%26lt%3B%2Fspan%26gt%3B%26amp%3Bnbsp%3B%20%26amp%3Bnbsp%3B%20%26lt%3B%2Fi%26gt%3B%26lt%3Bspan%20style%3D%26quot%3Bcolor%3A%20light-dark(rgb(0%2C%200%2C%200)%2C%20rgb(255%2C%20255%2C%20255))%3B%20background-color%3A%20transparent%3B%26quot%3B%26gt%3B%26lt%3Bi%20style%3D%26quot%3Bfont-weight%3A%20bold%3B%26quot%3B%26gt%3B%26amp%3Bnbsp%3B%26lt%3B%2Fi%26gt%3B%26lt%3B%2Fspan%26gt%3B%26lt%3Bspan%20style%3D%26quot%3Bbackground-color%3A%20transparent%3B%20color%3A%20light-dark(rgb(0%2C%200%2C%200)%2C%20rgb(255%2C%20255%2C%20255))%3B%26quot%3B%26gt%3B%26lt%3Bb%26gt%3B%26lt%3B%2Fb%26gt%3B%26lt%3B%2Fspan%26gt%3B%26lt%3B%2Fdiv%26gt%3B%22%20style%3D%22whiteSpace%3Dwrap%3Bhtml%3D1%3BfontSize%3D11%3BverticalAlign%3Dtop%3Balign%3Dleft%3B%22%20vertex%3D%221%22%20parent%3D%221%22%3E%3CmxGeometry%20x%3D%222068%22%20y%3D%221460%22%20width%3D%22720%22%20height%3D%22222%22%20as%3D%22geometry%22%2F%3E%3C%2FmxCell%3E%3C%2Froot%3E%3C%2FmxGraphModel%3E&lt;/span&gt;&lt;/h4&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;/blockquote&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;i style=&quot;font-weight: bold;&quot;&gt;&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp; &lt;/i&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;&lt;i style=&quot;font-weight: bold;&quot;&gt;&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontSize=11;verticalAlign=top;align=left;" parent="1" vertex="1">
